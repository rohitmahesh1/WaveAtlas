{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WaveAtlas",
  "version": "0.1.0",
  "identifier": "net.rohitmahesh.waveatlas",
  "build": { "frontendDist": "../ui" },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'none'",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Rohit Mahesh",
    "shortDescription": "Local wave analysis for kymograph research data",
    "icon": ["icons/icon.ico"],
    "resources": { "../payload/": "backend/" },
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller", "silent": true },
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false }
    }
  }
}
